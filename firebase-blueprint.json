{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for admin, teacher, intern, or student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "username": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "enum": ["admin", "teacher", "intern", "student"] },
        "avatar": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended"] },
        "joinDate": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "role", "email", "phone"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational course provided by Shokooh Danesh",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 200 },
        "capacity": { "type": "number" },
        "enrolledCount": { "type": "number" },
        "scheduleDays": { "type": "string", "maxLength": 200 },
        "scheduleTime": { "type": "string", "maxLength": 100 },
        "room": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["enrolling", "active", "completed"] },
        "price": { "type": "number" },
        "teacherWage": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "startDate": { "type": "string", "maxLength": 50 },
        "endDate": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "teacherId", "teacherName", "price"]
    },
    "Project": {
      "title": "Project",
      "description": "Institute real-world project assigned to interns",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 3000 },
        "clientName": { "type": "string", "maxLength": 200 },
        "leadInternId": { "type": "string", "maxLength": 128 },
        "leadInternName": { "type": "string", "maxLength": 200 },
        "deadline": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["new", "in_progress", "needs_review", "completed", "archived"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] }
      },
      "required": ["id", "title", "leadInternId", "status"]
    },
    "DailyReport": {
      "title": "DailyReport",
      "description": "Daily activity and progress report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 200 },
        "userRole": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 50 },
        "tasksDone": { "type": "string", "maxLength": 3000 },
        "hoursWorked": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "date", "tasksDone"]
    },
    "CustomerLead": {
      "title": "CustomerLead",
      "description": "Prospective student lead and inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "courseInterest": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "fullName", "phone"]
    },
    "TuitionRecord": {
      "title": "TuitionRecord",
      "description": "Student tuition accounting record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "studentId", "courseId", "totalAmount"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Financial payment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "amount", "date"]
    },
    "InstallmentPlan": {
      "title": "InstallmentPlan",
      "description": "Scheduled installment payment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "amount", "dueDate"]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Institute operational expense",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "amount", "date"]
    },
    "TeacherSalaryRecord": {
      "title": "TeacherSalaryRecord",
      "description": "Teacher salary payout entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "teacherId", "amount", "date"]
    },
    "GroupLink": {
      "title": "GroupLink",
      "description": "Institute group chat or channel link",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 500 },
        "platform": { "type": "string", "maxLength": 50 },
        "audienceType": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "url"]
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "In-app system notification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "read": { "type": "boolean" }
      },
      "required": ["id", "title", "message"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Institute activity log record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "action", "timestamp"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Diagnostic healthcheck document",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Institute users collection"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Institute courses collection"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Institute projects collection"
    },
    "/dailyReports/{reportId}": {
      "schema": "DailyReport",
      "description": "Daily reports submitted by students and staff"
    },
    "/customerLeads/{leadId}": {
      "schema": "CustomerLead",
      "description": "Customer leads and CRM prospects"
    },
    "/tuitions/{tuitionId}": {
      "schema": "TuitionRecord",
      "description": "Student tuition accounts"
    },
    "/payments/{paymentId}": {
      "schema": "PaymentTransaction",
      "description": "Payment records"
    },
    "/installments/{installmentId}": {
      "schema": "InstallmentPlan",
      "description": "Scheduled installments"
    },
    "/expenses/{expenseId}": {
      "schema": "ExpenseRecord",
      "description": "Operational expenses"
    },
    "/teacherSalaries/{salaryId}": {
      "schema": "TeacherSalaryRecord",
      "description": "Teacher compensation payments"
    },
    "/groupLinks/{linkId}": {
      "schema": "GroupLink",
      "description": "Institute social group channels and links"
    },
    "/notifications/{notificationId}": {
      "schema": "SystemNotification",
      "description": "System notifications"
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "System activity logs"
    },
    "/test/{testId}": {
      "schema": "ConnectionTest",
      "description": "Connection verification path"
    }
  }
}
